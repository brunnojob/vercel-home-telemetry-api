{
  "repository": "brunnojob/vercel-home-telemetry-api",
  "inputs": [
    ".proof/scenarios.json",
    ".proof/demo.mjs",
    "cloud/outbox.rb",
    ".proof/ruby-demo.rb"
  ],
  "cases": [
    {
      "name": "npm ci",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "npm ci"
      ],
      "timeout": 900,
      "display": false
    },
    {
      "name": "npm test",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "npm test"
      ],
      "timeout": 900,
      "display": true
    },
    {
      "name": "npm run typecheck",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "npm run typecheck"
      ],
      "timeout": 900,
      "display": true
    },
    {
      "name": "python -m unittest discover -v -s cloud",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "python -m unittest discover -v -s cloud"
      ],
      "timeout": 900,
      "display": true
    },
    {
      "name": "Run real Request/Response adapter and enforce input limits",
      "argv": [
        "node",
        ".proof/demo.mjs"
      ],
      "contains": [
        "\"oversized_body\":413"
      ],
      "timeout": 120
    },
    {
      "name": "Ruby delivery receipt and retry regression tests",
      "argv": [
        "ruby",
        "cloud/test_outbox.rb"
      ],
      "contains": [
        "Ruby outbox checks passed"
      ]
    },
    {
      "name": "Persist Ruby outbox, recover after restart and reject corrupt records",
      "argv": [
        "ruby",
        ".proof/ruby-demo.rb"
      ],
      "contains": [
        "\"idempotent_replay\":true",
        "\"corrupt_record_rejected\":true"
      ]
    }
  ]
}
